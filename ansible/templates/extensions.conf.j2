;
; Extensions Configuration for Ainslie Phone Gallery
; Auto-generated by Ansible - do not edit manually
; Generated: {{ ansible_date_time.iso8601 }}
;

[general]
static=yes
writeprotect=no

[globals]
; Global variables for session state management
LAST_RECORDING_FILE=""

[from-phone]
; F001: Phone Pickup Detection - Main entry point when phone goes off-hook
; This extension matches the 's' extension when HT801 auto-dials on pickup

; F002: DTMF Navigation - Help System (F101)
exten => 0,1,NoOp(=== F002: Help/Instruction Replay ===)
same => n,Playtones(congestion)
same => n,Wait(2)
same => n,Goto(help-prompt,1)


; F203: Pattern-matched DTMF Navigation - Any 1-3 digit extension (0-999)
; Matches extensions 0-9, 00-99, 000-999
; Plays ainslie/<extension>/recording.wav if present
; See https://docs.asterisk.org/Configuration/Dialplan/Pattern-Matching/
exten => _X,1,NoOp(=== F203: Playing Recording for 1-digit EXTEN ${EXTEN} ===)
 same => n,Gosub(playback-handler,s,1(ainslie/${EXTEN}/recording))
 same => n,Background(ainslie/${EXTEN}/recording)
 same => n,Goto(wait-for-input,1)

; exten => _XX,1,NoOp(=== F203: Playing Recording for 2-digit EXTEN ${EXTEN} ===)
;  same => n,Gosub(playback-handler,s,1(ainslie/${EXTEN}/recording))
;  same => n,Background(ainslie/${EXTEN}/recording)
;  same => n,Goto(wait-for-input,1)

; exten => _XXX,1,NoOp(=== F203: Playing Recording for 3-digit EXTEN ${EXTEN} ===)
;  same => n,Gosub(playback-handler,s,1(ainslie/${EXTEN}/recording))
;  same => n,Background(ainslie/${EXTEN}/recording)
;  same => n,Goto(wait-for-input,1)

; F002: Star (*) - Repeat last played recording (F102)
exten => *,1,NoOp(=== F002: Repeat Last Recording ===)
same => n,Gosub(playback-handler,s,1(${LAST_RECORDING_FILE}))
same => n,Background(${LAST_RECORDING_FILE})
same => n,Goto(wait-for-input,1)

; F002: Hash (#) - Random recording selection (F103)
exten => #,1,NoOp(=== F002: Random Recording Selection ===)
same => n,Set(RANDOM_NUM=$[${RAND(1,9)}])
same => n,NoOp(Selected random recording: ${RANDOM_NUM})
same => n,Goto(${RANDOM_NUM},1)

; Help prompt extension (F101)
exten => help-prompt,1,NoOp(=== F101: Help System ===)
same => n,Gosub(playback-handler,s,1(ainslie/0/recording))
same => n,Background(ainslie/0/recording)
same => n,Goto(wait-for-input,1)

; Wait for input state - listens for DTMF with immediate response (F104)
exten => wait-for-input,1,NoOp(=== F104: Waiting for DTMF Input ===)
same => n,WaitExten(5)  ; Wait up to 5 seconds for DTMF input
same => n,Goto(help-prompt,1)  ; If no input, replay help

; F005: Hangup detection and cleanup
exten => h,1,NoOp(=== F005: Hangup Detected - Cleaning Up ===)
same => n,Set(LAST_RECORDING_FILE="")  ; Clear session state
same => n,NoOp(Session terminated cleanly)

[playback-handler]
; Handler only sets LAST_RECORDING_FILE, no playback
; Expects ARG1 to be the base file path (without extension)
exten => s,1,NoOp(=== Playback Handler: Setting LAST_RECORDING_FILE to ${ARG1} ===)
same => n,Set(LAST_RECORDING_FILE=${ARG1})
same => n,Return()
