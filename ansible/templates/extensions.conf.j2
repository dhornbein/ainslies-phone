[general]
static=yes
writeprotect=no

[globals]
; Global variables for session state management
LAST_RECORDING=""

[from-phone]
; F001: Phone Pickup Detection - Main entry point when phone goes off-hook
; This extension matches the 's' extension when HT801 auto-dials on pickup

; F002: DTMF Navigation - Help System (F101)
exten => 0,1,NoOp(=== F002: Help/Instruction Replay ===)
same => n,Goto(help-prompt,1)

; F002: DTMF Navigation - Recordings 1-9 (using built-in sounds for testing)
exten => 1,1,NoOp(=== F002: Playing Recording 1 ===)
same => n,Set(LAST_RECORDING=1)
same => n,Background(demo-abouttotry)
same => n,Goto(wait-for-input,1)

exten => 2,1,NoOp(=== F002: Playing Recording 2 ===)
same => n,Set(LAST_RECORDING=2)
same => n,Background(demo-congrats)
same => n,Goto(wait-for-input,1)

