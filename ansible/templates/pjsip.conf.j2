;
; PJSIP Configuration for Ainslie Phone Gallery
; Auto-generated by Ansible - do not edit manually
; Generated: {{ ansible_date_time.iso8601 }}
;

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0

[ht801-endpoint]
type=endpoint
context=from-phone
disallow=all
allow=ulaw
allow=alaw
; F002: Enable RFC2833 DTMF for immediate response
;dtmf_mode=rfc2833
direct_media=no
aors=ht801-aor
; Enable inbound calls to trigger 's' extension
send_pai=yes
trust_id_inbound=yes

[ht801-aor]
type=aor
max_contacts=1
remove_existing=yes ; This helps with static IP devices

[ht801-identify]
type=identify
endpoint=ht801-endpoint
match={{ ht801_ip }}
