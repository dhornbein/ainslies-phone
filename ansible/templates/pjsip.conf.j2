[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0

[ht801-endpoint]
type=endpoint
context=from-phone
disallow=all
allow=ulaw
direct_media=no
aors=ht801-aor

[ht801-aor]
type=aor
max_contacts=1
remove_existing=yes ; This helps with static IP devices

[ht801-identify]
type=identify
endpoint=ht801-endpoint
match={{ ht801_ip }}
